+def test_percent_paths_export_multiple_frames(tmp_path, ffmpeg):
+    directory = tmp_path / "offer 42%"
+    directory.mkdir()
+    frames = patterned_frames(9)
+    source = encode(ffmpeg, directory / "50% source.mkv", frames)
+    before = source.read_bytes()
+    analysis = analysis_for(source, directory / "analysis", [0, 4, 8])
+    result = core.export_analysis(analysis, Options(output=directory / "export 20%"))
+    assert len(result["files"]) == 3
+    for item in result["files"]:
+        np.testing.assert_allclose(read_pixels(item["path"]), frames[item["frame_index"]], atol=1)
+    assert source.read_bytes() == before
