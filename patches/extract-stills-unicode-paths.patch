+def test_unicode_source_and_output_paths_preserve_previews_and_export(tmp_path, ffmpeg, neutral_vision):
+    directory = tmp_path / "stills caf\u00e9 \u65e5\u672c\u8a9e"
+    directory.mkdir()
+    frames = patterned_frames(9)
+    source = encode(ffmpeg, directory / "source caf\u00e9.mkv", frames)
+    before = source.read_bytes()
+    analysis = core.analyze_video(source, Options(output=directory / "analysis \u65e5\u672c\u8a9e"))
+    assert analysis["selected_ids"]
+    for candidate in analysis["candidates"]:
+        preview = Path(analysis["analysis_dir"]) / candidate["preview"]
+        with Image.open(preview) as image:
+            assert image.size == (frames[0].shape[1], frames[0].shape[0])
+        assert core._read_preview(preview).shape == frames[0].shape
+    result = core.export_analysis(analysis, Options(output=directory / "export caf\u00e9"))
+    assert result["files"]
+    for item in result["files"]:
+        with Image.open(item["path"]) as image:
+            pixels = np.asarray(image.convert("RGB"))[:, :, ::-1]
+            np.testing.assert_allclose(pixels, frames[item["frame_index"]], atol=1)
+    assert source.read_bytes() == before
+
