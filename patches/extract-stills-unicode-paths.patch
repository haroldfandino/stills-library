 def _write_preview(path, frame):
-    if not cv2.imwrite(str(path), frame, [cv2.IMWRITE_JPEG_QUALITY, 94]):
+    # OpenCV's Windows file APIs cannot open every Unicode path. Keep its
+    # image codec, but let Python perform filesystem I/O with wide paths.
+    success, encoded = cv2.imencode(".jpg", frame, [cv2.IMWRITE_JPEG_QUALITY, 94])
+    if not success:
         raise IOError(f"Cannot write preview: {path}")
+    Path(path).write_bytes(encoded.tobytes())
+
+
+def _read_preview(path):
+    image = cv2.imdecode(np.frombuffer(Path(path).read_bytes(), dtype=np.uint8), cv2.IMREAD_COLOR)
+    if image is None:
+        raise IOError(f"Cannot read preview: {path}")
+    return image


